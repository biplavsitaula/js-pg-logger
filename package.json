  },
  "keywords": [
    "js-api-log",
    "logger-for-node-server"
  ],
  "author": "Biplav Sitaula https://biplavsitaula.com.np/",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/biplavsitaula/js-pg-logger"
  },
  "bugs": {
    "url": "https://github.com/biplavsitaula/js-pg-logger/issues"
  },
  "homepage": "https://github.com/biplavsitaula/js-pg-logger"
